@page "/"
@model IndexModel
@{
    ViewData["Locale"] = Model.CurrentLanguage;
    ViewData["Title"] = Model.PageTitle;
}
<main class="main-content">
    @if (Model.CurrentPage == "readings") { @await Html.PartialAsync("Shared/_Readings", Model) }
    else if (Model.CurrentPage == "prayer-library") { @await Html.PartialAsync("Shared/_PrayerLibrary", Model) }
    else if (Model.CurrentPage == "rosary") { @await Html.PartialAsync("Shared/_Rosary", Model) }
    else if (Model.CurrentPage == "holy-mass") { @await Html.PartialAsync("Shared/_HolyMass", Model) }
    else if (Model.CurrentPage == "about") { @await Html.PartialAsync("Shared/_About", Model) }
    else { @await Html.PartialAsync("Shared/_Home", Model) }
</main>
