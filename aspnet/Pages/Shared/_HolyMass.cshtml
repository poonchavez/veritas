@model IndexModel
@{
    var zh = Model.IsChinese;
}
<header class="page-heading"><div><span class="eyebrow">@(zh ? "羅馬禮" : "THE ROMAN RITE")</span><h1>@(zh ? "彌撒常規" : "Order of Holy Mass")</h1><p>@(zh ? "按彌撒的次序，參與這神聖的禮儀。" : "Follow the prayers and rhythm of the celebration.")</p></div><span class="heading-mark">✝</span></header>
<section class="mass-intro"><span class="eyebrow">@(zh ? "彌撒常用經文" : "A PRAYERFUL GUIDE")</span><h2>@(zh ? "同心參與聖祭。" : "Enter into the celebration.")</h2><p>@(zh ? "以下是羅馬禮普通形式彌撒的主要部分與答句。" : "A guide to the principal parts and responses of the Ordinary Form of the Roman Rite.")</p><span class="mass-languages">@(zh ? "繁體中文 · 英文" : "ENGLISH · TRADITIONAL CHINESE")</span></section>
<nav class="mass-toc" aria-label="@(zh ? "彌撒部分" : "Parts of the Mass")"><a href="#introductory">@(zh ? "進堂禮" : "Introductory Rites")</a><a href="#word">@(zh ? "聖道禮" : "Liturgy of the Word")</a><a href="#eucharist">@(zh ? "聖祭禮" : "Liturgy of the Eucharist")</a><a href="#communion">@(zh ? "領聖體禮" : "Communion Rite")</a><a href="#concluding">@(zh ? "禮成式" : "Concluding Rites")</a></nav>
<div class="mass-sections">
    <section class="mass-section" id="introductory"><span class="section-index">01</span><div><span class="eyebrow">@(zh ? "聚集 · 準備" : "GATHER · PREPARE")</span><h2>@(zh ? "進堂禮" : "Introductory Rites")</h2><div class="response"><p>@(zh ? "因父、及子、及聖神之名。" : "In the name of the Father, and of the Son, and of the Holy Spirit.")</p><strong>@(zh ? "亞孟。" : "Amen.")</strong></div><div class="response"><p>@(zh ? "願主與你們同在。" : "The Lord be with you.")</p><strong>@(zh ? "也與你的心靈同在。" : "And with your spirit.")</strong></div><h3>@(zh ? "垂憐經" : "Kyrie")</h3><p>@(zh ? "上主，求你垂憐。基督，求你垂憐。上主，求你垂憐。" : "Lord, have mercy. Christ, have mercy. Lord, have mercy.")</p></div></section>
    <section class="mass-section" id="word"><span class="section-index">02</span><div><span class="eyebrow">@(zh ? "聆聽 · 回應" : "LISTEN · RESPOND")</span><h2>@(zh ? "聖道禮" : "Liturgy of the Word")</h2><p>@(zh ? "我們聆聽聖經中的天主聖言，以答唱詠回應，並在福音中聽見基督的聲音。" : "We listen to the Scriptures, respond in the psalm, and hear the voice of Christ in the Gospel.")</p><div class="response"><p>@(zh ? "上主的話。" : "The word of the Lord.")</p><strong>@(zh ? "感謝天主。" : "Thanks be to God.")</strong></div><div class="response"><p>@(zh ? "願主與你們同在。" : "The Lord be with you.")</p><strong>@(zh ? "也與你的心靈同在。" : "And with your spirit.")</strong></div><div class="response"><p>@(zh ? "恭讀聖福音。" : "A reading from the holy Gospel.")</p><strong>@(zh ? "主，願光榮歸於你。" : "Glory to you, O Lord.")</strong></div></div></section>
    <section class="mass-section" id="eucharist"><span class="section-index">03</span><div><span class="eyebrow">@(zh ? "奉獻 · 感恩" : "OFFER · GIVE THANKS")</span><h2>@(zh ? "聖祭禮" : "Liturgy of the Eucharist")</h2><p>@(zh ? "餅酒被奉獻於祭台上；感恩經中，教會與基督一同將讚頌獻給天父。" : "Bread and wine are brought to the altar. In the Eucharistic Prayer, the Church gives thanks to the Father with Christ.")</p><div class="response"><p>@(zh ? "請眾為我的祭獻，也為你們的祭獻，祈求全能的天主聖父悅納。" : "Pray, brethren, that my sacrifice and yours may be acceptable to God, the almighty Father.")</p><strong>@(zh ? "望上主從你的手中收納這個祭獻，為讚美並光榮他的名，也為我們和他的整個聖教會的益處。" : "May the Lord accept the sacrifice at your hands for the praise and glory of his name, for our good and the good of all his holy Church.")</strong></div></div></section>
    <section class="mass-section" id="communion"><span class="section-index">04</span><div><span class="eyebrow">@(zh ? "共融 · 領受" : "COMMUNION · RECEIVE")</span><h2>@(zh ? "領聖體禮" : "Communion Rite")</h2><p>@(zh ? "在天主經中，我們求天父賜下日用食糧，並以平安禮彼此相通。" : "In the Lord’s Prayer, we ask the Father for our daily bread and share a sign of peace.")</p><div class="response"><p>@(zh ? "請看，天主的羔羊；請看，除免世罪者。" : "Behold the Lamb of God; behold him who takes away the sins of the world.")</p><strong>@(zh ? "主，我當不起你到我心裡來，只要你說一句話，我的靈魂就會痊癒。" : "Lord, I am not worthy that you should enter under my roof, but only say the word and my soul shall be healed.")</strong></div></div></section>
    <section class="mass-section" id="concluding"><span class="section-index">05</span><div><span class="eyebrow">@(zh ? "蒙受派遣" : "BE SENT FORTH")</span><h2>@(zh ? "禮成式" : "Concluding Rites")</h2><div class="response"><p>@(zh ? "彌撒禮成。平安去吧！" : "Go forth, the Mass is ended.")</p><strong>@(zh ? "感謝天主。" : "Thanks be to God.")</strong></div><p>@(zh ? "帶著所領受的恩寵，回到日常生活，並以愛德服務近人。" : "Carry the grace you have received into daily life, and serve your neighbour with love.")</p></div></section>
</div>
<p class="source-note">@(zh ? "此頁為祈禱輔助資料，完整經文請以彌撒經書為準。" : "This page is a prayer aid. Refer to the approved Missal for the complete texts.")</p>
